# ===========================================================================
#  Soul and Body — variables de entorno
#
#  Copia este archivo a `.dev.vars` (NO a `.env`) para desarrollo local:
#    cp .env.example .dev.vars
#  `.dev.vars` está en .gitignore y es lo que wrangler lee en `npm run dev`.
#
#  En producción NO se sube ningún archivo: los secretos se dan por CLI:
#    npx wrangler secret put SESSION_SECRET
# ===========================================================================

# --- PUBLICIDAD Y SEO -------------------------------------------------------

# URL pública del sitio. En local no hace falta; en producción define los
# canonical, el sitemap y los datos estructurados. Cuando exista el dominio
# propio, se ajusta aquí y en astro.config.mjs.
# PUBLIC_URL=https://soulandbody.com.co

# --- SEGURIDAD --------------------------------------------------------------

# Clave para firmar la cookie de sesión del panel (HMAC-SHA256).
# Obligatoria en producción. Generar con:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios

# --- ANTI-BOT ---------------------------------------------------------------

# Cloudflare Turnstile. Panel en https://dash.cloudflare.com → Turnstile.
# Las claves de prueba de Cloudflare sirven para desarrollo:
#   sitekey  1x00000000000000000000AA   (siempre pasa)
#   secret   1x0000000000000000000000000000000AA
# Turnstile es opcional en local: si falta, la API omite la verificación.
TURNSTILE_SECRET_KEY=

# --- CORREO -----------------------------------------------------------------

# Proveedor transaccional. Brevo funciona sin dominio propio (300/día);
# cuando tengas dominio, migra a Resend para tener SPF/DKIM propios.
BREVO_API_KEY=

# Email al que llegan las notificaciones internas (aviso de reserva nueva).
ADMIN_EMAIL=wendy@soulandbody.co

# --- OPCIONALES -------------------------------------------------------------

# Zona horaria de referencia. Colombia es UTC-5 todo el año.
BUSINESS_TZ=America/Bogota