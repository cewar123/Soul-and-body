# ======================================================================
#  Soul and Body — Configuración de entorno (PLANTILLA) — Supabase
# ----------------------------------------------------------------------
#  Copia este archivo como ".env" y completa los valores reales.
#  NUNCA subas el archivo ".env" a git ni lo compartas: contiene secretos.
# ======================================================================

# --- Servidor ---------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública del sitio (para enlaces en correos). Sin barra final.
PUBLIC_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------
# Créate un proyecto gratis en https://supabase.com (tarda 2 minutos).
# Settings → API: copia "Project URL" y "service_role" key (NO la anon).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxx

# --- Seguridad --------------------------------------------------------
# Genera secretos largos y aleatorios. Ejemplo para generarlos:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo_y_aleatorio
# Duración de la sesión del panel admin (formato de "jsonwebtoken").
SESSION_TTL=8h

# --- Credenciales del panel de administración -------------------------
# Se usan UNA sola vez al ejecutar "npm run seed" para crear el usuario.
# Después puedes cambiar la contraseña desde el propio panel.
ADMIN_USERNAME=wendy
ADMIN_PASSWORD=CAMBIA_esta_clave_segura_2026

# --- Negocio ----------------------------------------------------------
# Zona horaria IANA. Colombia = America/Bogota.
BUSINESS_TZ=America/Bogota
# Correo donde Wendy recibe las notificaciones de nuevas reservas.
BUSINESS_EMAIL=germanitsomg@gmail.com
# WhatsApp del negocio en formato internacional sin "+" ni espacios.
BUSINESS_WHATSAPP=573136147706

# --- Envío de correos (SMTP) ------------------------------------------
# Opcional: si se deja vacío, el sistema sigue funcionando y guarda las
# reservas, pero no enviará correos (degradación elegante).
#
# Para Gmail: activa la verificación en dos pasos y crea una
# "Contraseña de aplicación" (16 caracteres) en https://myaccount.google.com/apppasswords
# Pega esa contraseña de aplicación en SMTP_PASS (no tu clave normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=germanitsomg@gmail.com
SMTP_PASS=
# Nombre y correo que aparecen como remitente.
MAIL_FROM_NAME=Soul and Body
MAIL_FROM_EMAIL=germanitsomg@gmail.com
