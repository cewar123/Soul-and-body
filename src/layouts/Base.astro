---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SiteConfig } from '../lib/config.ts';

interface Props {
  title: string;
  description: string;
  config: SiteConfig;
  /** 'website' | 'article' | 'profile' */
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Portada: sin cabecera ni pie propios. */
  bare?: boolean;
}

const { title, description, config, ogType = 'website', noindex = false, bare = false } =
  Astro.props;

const { business } = config;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-default.svg', site).href;

const fullAddress = [business.address, business.city, business.department].filter(Boolean).join(', ');
const mapQuery = encodeURIComponent(fullAddress);

/**
 * Datos estructurados.
 *
 * Solo los tipos que Google sigue mostrando. Descartado a propósito:
 *  · FAQPage  — sin rich result desde mayo 2026.
 *  · AggregateRating sobre el propio negocio — Google no lo muestra y es la vía
 *    más común a un aviso por «contenido que induce a error».
 *  · WebSite + SearchAction — el sitelinks search box se retiró en nov 2024.
 */
const organization = {
  '@type': ['HealthAndBeautyBusiness', 'LocalBusiness'],
  '@id': `${site}/#negocio`,
  name: business.name,
  description,
  url: `${site}/`,
  telephone: business.phoneE164,
  image: [ogImage],
  logo: ogImage,
  priceRange: '$$',
  currenciesAccepted: 'COP',
  paymentAccepted: business.paymentAccepted,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address,
    addressLocality: business.city,
    addressRegion: business.department,
    addressCountry: business.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geoLat,
    longitude: business.geoLng,
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${mapQuery}`,
  areaServed: [
    { '@type': 'City', name: 'Envigado' },
    { '@type': 'City', name: 'Sabaneta' },
    { '@type': 'City', name: 'La Estrella' },
    { '@type': 'Place', name: 'Itagüí' },
    { '@type': 'Place', name: 'Medellín' },
  ],
  sameAs: [business.instagram],
  openingHoursSpecification: Object.entries(config.schedule)
    .filter((entry): entry is [string, { open: string; close: string }] => entry[1] !== null)
    .map(([day, window]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Sunday',
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
      ][Number(day)],
      opens: window.open,
      closes: window.close,
    })),
  founder: {
    '@type': 'Person',
    name: business.owner,
    jobTitle: 'Esteticista',
    worksFor: { '@id': `${site}/#negocio` },
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="CO-ANT" />
    <meta name="geo.placename" content={business.city} />
    <meta name="geo.position" content={`${business.geoLat}, ${business.geoLng}`} />
    <meta name="ICBM" content={`${business.geoLat}, ${business.geoLng}`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <Header business={business} />
          <slot />
          <Footer business={business} schedule={config.schedule} />
        </>
      )
    }
  </body>
</html>