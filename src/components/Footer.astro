---
import type { BusinessInfo } from '../lib/config.ts';
import type { DayWindow } from '../lib/time.ts';

interface Props {
  business: BusinessInfo;
  schedule: Record<string, DayWindow | null>;
}

const { business, schedule } = Astro.props;

const days: { label: string; window: DayWindow | null }[] = [
  { label: 'Lunes', window: schedule['1'] ?? null },
  { label: 'Martes', window: schedule['2'] ?? null },
  { label: 'Miércoles', window: schedule['3'] ?? null },
  { label: 'Jueves', window: schedule['4'] ?? null },
  { label: 'Viernes', window: schedule['5'] ?? null },
  { label: 'Sábado', window: schedule['6'] ?? null },
  { label: 'Domingo', window: schedule['0'] ?? null },
];

const year = new Date().getFullYear();
const fullAddress = [business.address, business.city, business.department]
  .filter(Boolean)
  .join(', ');
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        <p class="site-footer__name">{business.name}</p>
        <p class="site-footer__tagline">{business.tagline}</p>
        <p class="site-footer__owner">{business.owner}</p>
        <a class="site-footer__social" href={business.instagram} rel="me noopener">
          {business.instagramHandle}
        </a>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Contacto</h2>
        <address>
          {business.address && <span class="site-footer__line">{business.address}</span>}
          <span class="site-footer__line">{business.city}, {business.department}</span>
          <a class="site-footer__line" href={`tel:${business.phoneE164}`}>
            {business.phoneDisplay}
          </a>
          <a class="site-footer__line" href={`mailto:${business.contactEmail}`}>
            {business.contactEmail}
          </a>
        </address>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Horario</h2>
        <ul class="hours">
          {
            days.map(({ label, window }) => (
              <li class="hours__row">
                <span>{label}</span>
                <span class="hours__value">
                  {window ? `${window.open} – ${window.close}` : 'Cerrado'}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Reservas</h2>
        <ul class="site-footer__list">
          <li><a href="/#reserva">Agendar una cita</a></li>
          <li><a href="/#servicios">Ver servicios</a></li>
          <li><a href="/#preguntas">Preguntas frecuentes</a></li>
          <li><a href="/legal/privacidad">Aviso de privacidad</a></li>
          <li><a href="/legal/terminos">Términos y condiciones</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {business.name}. Todos los derechos reservados.</p>
      <p class="site-footer__note">
        {business.city}, {business.department}, Colombia.
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`}
          target="_blank" rel="noopener">Ver en el mapa</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-8) var(--space-6);
    background: var(--burgundy);
    color: var(--blush-100);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid rgb(249 232 228 / 0.18);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--blush-50);
  }

  .site-footer__tagline {
    color: var(--gold-soft);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-xs);
  }

  .site-footer__owner {
    margin-top: var(--space-3);
    color: rgb(249 232 228 / 0.75);
  }

  .site-footer__social {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--gold-soft);
  }

  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  .site-footer__line {
    display: block;
    color: rgb(249 232 228 / 0.85);
    font-style: normal;
    text-decoration: none;
  }

  .site-footer__line:hover {
    color: var(--blush-50);
  }

  .site-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list a {
    display: block;
    padding-block: 0.2rem;
    color: rgb(249 232 228 / 0.85);
    text-decoration: none;
  }

  .site-footer__list a:hover {
    color: var(--blush-50);
    text-decoration: underline;
  }

  .hours {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 0.2rem;
    color: rgb(249 232 228 / 0.85);
  }

  .hours__value {
    color: var(--blush-100);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
    color: rgb(249 232 228 / 0.6);
    font-size: var(--text-xs);
  }

  .site-footer__note a {
    margin-left: var(--space-2);
    color: var(--gold-soft);
  }

  @media (width < 62rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (width < 38rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>